<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>WinExe</OutputType><UseWPF>true</UseWPF></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ProSyS.Core\ProSyS.Core.csproj" />
    <ProjectReference Include="..\ProSyS.Windows\ProSyS.Windows.csproj" />
    <ProjectReference Include="..\ProSyS.PrivilegedHelper\ProSyS.PrivilegedHelper.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\Fonts\Vazirmatn-Regular.ttf" />
    <Resource Include="Assets\Fonts\Vazirmatn-SemiBold.ttf" />
    <Resource Include="Assets\Fonts\Vazirmatn-Bold.ttf" />
    <Content Include="Assets\Fonts\OFL.txt"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
  </ItemGroup>
  <ItemGroup>
    <!-- The Intel binary is not committed; run tools/PresentMon/fetch.ps1 to download and hash-verify it. -->
    <Content Include="..\..\tools\PresentMon\2.6.0\PresentMon.exe" Condition="Exists('..\..\tools\PresentMon\2.6.0\PresentMon.exe')" Link="Tools\PresentMon\PresentMon.exe"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory></Content>
    <Content Include="..\..\tools\PresentMon\manifest.json" Link="Tools\PresentMon\manifest.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory></Content>
    <Content Include="..\..\tools\PresentMon\LICENSE.txt" Link="Tools\PresentMon\LICENSE.txt"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory></Content>
  </ItemGroup>
  <Target Name="WarnMissingPresentMon" BeforeTargets="Build" Condition="!Exists('..\..\tools\PresentMon\2.6.0\PresentMon.exe')">
    <Warning Code="PROSYS001" Text="PresentMon 2.6.0 is not present; benchmarking will be unavailable. Run tools/PresentMon/fetch.ps1 before building a release." />
  </Target>
  <Target Name="CopyPrivilegedHelper" AfterTargets="Build">
    <!-- Copy the helper together with its dependencies (System.Management and its runtime assets). -->
    <ItemGroup><PrivilegedHelperFiles Include="..\ProSyS.PrivilegedHelper\bin\$(Configuration)\net8.0-windows10.0.22621.0\**\*" /></ItemGroup>
    <Copy SourceFiles="@(PrivilegedHelperFiles)" DestinationFiles="@(PrivilegedHelperFiles->'$(OutDir)Tools\PrivilegedHelper\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishPrivilegedHelper" AfterTargets="Publish">
    <!-- Publish the helper next to ProSyS.App.exe so a self-contained release shares one copy of the .NET runtime. -->
    <MSBuild Projects="..\ProSyS.PrivilegedHelper\ProSyS.PrivilegedHelper.csproj" Targets="Publish" Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishDir=$([System.IO.Path]::GetFullPath('$(PublishDir)'))" />
  </Target>
</Project>
