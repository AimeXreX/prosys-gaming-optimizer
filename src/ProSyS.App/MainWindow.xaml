        <TabItem><ScrollViewer><StackPanel Margin="30,26"><TextBlock Text="PRESENTMON BENCHMARK" FontSize="24" FontWeight="Bold"/><TextBlock Text="Capture real frame times, FPS lows and variance without injecting into the game." Foreground="{StaticResource Muted}" Margin="0,4,0,20"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource CardStyle}" Margin="0,0,14,0"><StackPanel><TextBlock Text="CAPTURE SETTINGS" FontWeight="SemiBold"/><TextBlock Text="Game process name" Foreground="{StaticResource Muted}" Margin="0,14,0,5"/><TextBox x:Name="BenchmarkProcessText" Text="game.exe"/><TextBlock Text="Duration (seconds)" Foreground="{StaticResource Muted}" Margin="0,14,0,5"/><ComboBox x:Name="BenchmarkDuration"><ComboBoxItem Content="15"/><ComboBoxItem Content="30" IsSelected="True"/><ComboBoxItem Content="60"/><ComboBoxItem Content="120"/></ComboBox><CheckBox x:Name="BenchmarkBaselineCheck" Content="Baseline run (before applying changes)" Margin="0,12,0,0"/><TextBlock x:Name="PresentMonTrustText" Text="Checking PresentMon trust…" Foreground="{StaticResource AccentBlue}" TextWrapping="Wrap" Margin="0,18,0,12"/><Button Content="START CAPTURE" Click="StartBenchmark_Click" Style="{StaticResource PrimaryButton}"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="LATEST RESULT" FontWeight="SemiBold"/><TextBlock x:Name="BenchmarkResultText" Text="No benchmark has been captured yet." Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="25" Margin="0,18,0,0"/><Button Content="COMPARE LAST TWO RUNS" Click="CompareBenchmarks_Click" Style="{StaticResource SecondaryButton}" Margin="0,22,0,0"/></StackPanel></Border></Grid><Border Style="{StaticResource CardStyle}" Margin="0,14,0,0"><StackPanel><TextBlock Text="AUTOMATIC A/B TEST" FontWeight="SemiBold"/><TextBlock Text="Stand still in a repeatable scene, then run. ProSyS 