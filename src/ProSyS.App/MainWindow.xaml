<Window x:Class="ProSyS.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProSyS Gaming Optimizer" Width="1320" Height="820" MinWidth="1040" MinHeight="680" WindowStartupLocation="CenterScreen"
        Background="#06070B" Foreground="#EEF2FA" FontFamily="./Assets/Fonts/#Vazirmatn" PreviewKeyDown="Window_PreviewKeyDown" Icon="Assets/Brand/prosys.ico">
  <Window.Resources>
    <SolidColorBrush x:Key="Card" Color="#12151E"/><SolidColorBrush x:Key="Accent" Color="#2DF5C8"/><SolidColorBrush x:Key="AccentBlue" Color="#67E8F9"/><SolidColorBrush x:Key="AccentViolet" Color="#8B5CF6"/><SolidColorBrush x:Key="Muted" Color="#8A93A8"/><SolidColorBrush x:Key="Stroke" Color="#222737"/>
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#2DF5C8" Offset="0"/><GradientStop Color="#19C9A4" Offset="1"/></LinearGradientBrush>
    <LinearGradientBrush x:Key="VioletGradient" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#9B6BFF" Offset="0"/><GradientStop Color="#6D3FE6" Offset="1"/></LinearGradientBrush>
    <LinearGradientBrush x:Key="CardBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#171B27" Offset="0"/><GradientStop Color="#12151E" Offset="0.45"/></LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#0E2E2D" Offset="0"/><GradientStop Color="#12151E" Offset="0.5"/><GradientStop Color="#221846" Offset="1"/></LinearGradientBrush>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EEF2FA"/></Style>
    <Style x:Key="PrimaryButton" TargetType="Button"><Setter Property="Foreground" Value="#04130F"/><Setter Property="Background" Value="{StaticResource AccentGradient}"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Padding" Value="20,11"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#2DF5C8" Opacity="0.30" BlurRadius="18" ShadowDepth="0"/></Setter.Value></Setter><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FDE047"/><Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Background" Value="#1A1E2B"/><Setter Property="Foreground" Value="#5B647A"/><Setter Property="Cursor" Value="Arrow"/><Setter Property="Effect" Value="{x:Null}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="VioletButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{StaticResource VioletGradient}"/><Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#8B5CF6" Opacity="0.35" BlurRadius="18" ShadowDepth="0"/></Setter.Value></Setter></Style>
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Setter Property="Foreground" Value="#EAF2FF"/><Setter Property="Background" Value="#1A1E2B"/><Setter Property="BorderBrush" Value="#2D3448"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Effect" Value="{x:Null}"/></Style>
    <Style x:Key="NavButton" TargetType="Button"><Setter Property="Foreground" Value="#8A93A8"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="14,11"/><Setter Property="Margin" Value="0,2"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="NavBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="11" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBorder" Property="BorderBrush" Value="#2D3448"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NavBorder" Property="BorderBrush" Value="#FDE047"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="CardStyle" TargetType="Border"><Setter Property="Background" Value="{StaticResource CardBrush}"/><Setter Property="CornerRadius" Value="16"/><Setter Property="BorderBrush" Value="{StaticResource Stroke}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="20"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EEF2FA"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="Track" Width="40" Height="22" CornerRadius="11" Background="#232839" BorderBrush="#2D3448" BorderThickness="1" VerticalAlignment="Center"><Ellipse x:Name="Thumb" Width="16" Height="16" Fill="#8993AB" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0"/></Border><ContentPresenter x:Name="Content" Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center" RecognizesAccessKey="True"/></Grid><ControlTemplate.Triggers><Trigger Property="HasContent" Value="False"><Setter TargetName="Content" Property="Margin" Value="0"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#123B36"/><Setter TargetName="Track" Property="BorderBrush" Value="#2DF5C8"/><Setter TargetName="Thumb" Property="Fill" Value="#2DF5C8"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsChecked" Value="{x:Null}"><Setter TargetName="Track" Property="Background" Value="#123B36"/><Setter TargetName="Track" Property="BorderBrush" Value="#2DF5C8"/><Setter TargetName="Thumb" Property="Fill" Value="#2DF5C8"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Center"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="#2DF5C8"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="#FDE047"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/><Setter Property="Cursor" Value="Arrow"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#EEF2FA"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
    <Style TargetType="ListBoxItem"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#EEF2FA"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,2"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#151925"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#10272A"/><Setter TargetName="ItemBorder" Property="BorderBrush" Value="#1F5A52"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ListView"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#EEF2FA"/></Style>
    <Style TargetType="DataGrid"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#EEF2FA"/><Setter Property="BorderThickness" Value="0"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#222737"/><Setter Property="RowBackground" Value="Transparent"/><Setter Property="AlternatingRowBackground" Value="#0E1118"/><Setter Property="HeadersVisibility" Value="Column"/></Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#12151E"/><Setter Property="Foreground" Value="#8A93A8"/><Setter Property="BorderBrush" Value="#222737"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="Padding" Value="12,9"/><Setter Property="HorizontalContentAlignment" Value="Right"/></Style>
    <Style TargetType="DataGridCell"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#EEF2FA"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,8"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style>
    <Style TargetType="DataGridRow"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="#1B2030"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="Foreground" Value="#EEF2FA"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#151925"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#10272A"/></Trigger></Style.Triggers></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#0A0D14"/><Setter Property="Foreground" Value="#EEF2FA"/><Setter Property="BorderBrush" Value="#2D3448"/><Setter Property="Padding" Value="12,9"/><Setter Property="CaretBrush" Value="{StaticResource Accent}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="TextBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TextBorder" Property="BorderBrush" Value="#2DF5C8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ComboBox"><Setter Property="Background" Value="#0A0D14"/><Setter Property="Foreground" Value="#EEF2FA"/><Setter Property="Padding" Value="11,8"/><Setter Property="BorderBrush" Value="#2D3448"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton x:Name="DropDownToggle" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderBrush="#2D3448" BorderThickness="1" CornerRadius="11" Padding="11,8"><Grid><ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" VerticalAlignment="Center"/><TextBlock Text="⌄" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="#8A93A8"/></Grid></Border></ControlTemplate></ToggleButton.Template></ToggleButton><Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False"><Border Background="#12151E" BorderBrush="#2D3448" BorderThickness="1" CornerRadius="11" Padding="4" Margin="0,4,0,0" MinWidth="{TemplateBinding ActualWidth}"><ScrollViewer><StackPanel IsItemsHost="True"/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#EEF2FA"/><Setter Property="Background" Value="#12151E"/><Setter Property="Padding" Value="12,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#10272A"/></Trigger></Style.Triggers></Style>
    <Style TargetType="ScrollBar"><Setter Property="Width" Value="10"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="{TemplateBinding Background}"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#2B3350" CornerRadius="4" Margin="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
  </Window.Resources>
  <Grid x:Name="RootLayout">
    <Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#0A0C12" BorderBrush="#222737" BorderThickness="0,0,1,0">
      <DockPanel Margin="16,22">
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" Margin="8,0,0,28"><Image Source="Assets/Brand/prosys-mark.png" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,12,0" VerticalAlignment="Center"/><StackPanel VerticalAlignment="Center"><TextBlock Text="PROSYS" FontSize="22" FontWeight="ExtraBold" Foreground="{StaticResource Accent}"/><TextBlock Text="GAMING CONTROL CENTER" FontSize="9" Foreground="{StaticResource Muted}"/></StackPanel></StackPanel>
          <Button x:Name="DashboardNav" Style="{StaticResource NavButton}" Tag="0" Click="Navigate_Click" Content="▰   DASHBOARD" Foreground="{StaticResource Accent}" Background="#102B2A"/>
          <Button x:Name="ScanNav" Style="{StaticResource NavButton}" Tag="1" Click="Navigate_Click" Content="◉   SYSTEM SCAN"/>
          <Button x:Name="RecommendationsNav" Style="{StaticResource NavButton}" Tag="2" Click="Navigate_Click" Content="✦   RECOMMENDATIONS"/>
          <Button x:Name="DiagnosticsNav" Style="{StaticResource NavButton}" Tag="3" Click="Navigate_Click" Content="⌁   DIAGNOSTICS"/>
          <Button x:Name="BackupsNav" Style="{StaticResource NavButton}" Tag="4" Click="Navigate_Click" Content="↶   HISTORY &amp; BACKUPS"/>
          <Button x:Name="BenchmarkNav" Style="{StaticResource NavButton}" Tag="6" Click="Navigate_Click" Content="◫   BENCHMARK &amp; A/B"/>
          <Button x:Name="GameProfilesNav" Style="{StaticResource NavButton}" Tag="7" Click="Navigate_Click" Content="◈   GAME PROFILES"/>
          <Button x:Name="OverlayNav" Style="{StaticResource NavButton}" Tag="8" Click="Navigate_Click" Content="▣   OVERLAY"/>
          <Button x:Name="SettingsNav" Style="{StaticResource NavButton}" Tag="5" Click="Navigate_Click" Content="⚙   SETTINGS"/>
          <Border Height="1" Background="#222737" Margin="8,22"/>
          <TextBlock Text="PROTECTION" Foreground="#5B647A" FontSize="10" Margin="14,0,0,10"/>
          <TextBlock Text="  ✓  Backup before changes" FontSize="11" Foreground="#8A93A8" Margin="5"/><TextBlock Text="  ✓  Verify after apply" FontSize="11" Foreground="#8A93A8" Margin="5"/><TextBlock Text="  ✓  Telemetry disabled" FontSize="11" Foreground="#8A93A8" Margin="5"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Margin="10,0"><Border Background="#0E2A22" BorderBrush="#1B4B3B" BorderThickness="1" CornerRadius="12" Padding="12"><StackPanel><TextBlock Text="● LOCAL MODE" Foreground="{StaticResource Accent}" FontWeight="SemiBold" FontSize="11"/><TextBlock Text="No cloud • No account" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,0"/></StackPanel></Border></StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Grid.Row="0" BorderBrush="#222737" BorderThickness="0,0,0,1" Padding="28,0"><DockPanel LastChildFill="False"><StackPanel DockPanel.Dock="Left" VerticalAlignment="Center"><TextBlock x:Name="PageTitle" Text="Dashboard" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="PageCaption" Text="Live system readiness and safe optimization" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="LanguageButton" Content="فا" Click="Language_Click" Style="{StaticResource SecondaryButton}" Padding="13,8" ToolTip="Switch language and direction"/><Border Background="#0F2A2A" BorderBrush="#1F5A52" BorderThickness="1" CornerRadius="18" Padding="14,8"><TextBlock x:Name="HeaderState" Text="NOT SCANNED" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold"/></Border></StackPanel></DockPanel></Border>
      <TabControl x:Name="MainTabs" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectedIndex="0">
        <TabControl.Resources><Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed"/></Style></TabControl.Resources>
        <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="30,26,30,38">
          <Border Margin="0,0,0,22" Padding="28,24" CornerRadius="20" BorderThickness="1" BorderBrush="#2D3448" Background="{StaticResource HeroBrush}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="StatusTitle" Text="READY WHEN YOU ARE" FontSize="32" FontWeight="ExtraBold"/><TextBlock x:Name="StatusSubtitle" Text="Run a scan to build a hardware-aware optimization plan." Foreground="{StaticResource Muted}" FontSize="14" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="ScanButton" Content="SCAN THIS PC" Click="Scan_Click" Style="{StaticResource PrimaryButton}"/><Button Content="EXPORT REPORT" Click="Export_Click" Style="{StaticResource SecondaryButton}"/></StackPanel></Grid></Border>
          <UniformGrid Columns="5" Margin="0,0,0,20">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0"><StackPanel><TextBlock Text="READINESS" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="ReadyScore" Text="—" FontSize="27" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,8,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0"><StackPanel><TextBlock Text="WINDOWS" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="WindowsValue" Text="—" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></Border>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0"><StackPanel><TextBlock Text="CPU" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="CpuValue" Text="—" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0"><StackPanel><TextBlock Text="MEMORY" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="MemoryValue" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="OPTIMIZATIONS" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="AvailableValue" Text="—" FontSize="27" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" Margin="0,8,0,0"/></StackPanel></Border>
          </UniformGrid>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource CardStyle}" Margin="0,0,14,0"><StackPanel><DockPanel LastChildFill="False"><TextBlock Text="SYSTEM OVERVIEW" FontWeight="SemiBold"/><TextBlock x:Name="LastScanText" Text="Never scanned" DockPanel.Dock="Right" Foreground="{StaticResource Muted}"/></DockPanel><ListView x:Name="OverviewList" Margin="0,14,0,0" MaxHeight="275"><ListView.ItemTemplate><DataTemplate><Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" Foreground="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="{Binding Value}" TextTrimming="CharacterEllipsis"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="QUICK OPTIMIZE" FontWeight="SemiBold"/><TextBlock Text="Only selected, compatible and reversible changes are applied." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,8,0,18"/><Button x:Name="QuickPlanButton" Content="REVIEW PLAN" Click="ReviewPlan_Click" Style="{StaticResource SecondaryButton}" IsEnabled="False" Margin="0,0,0,10"/><Button x:Name="ApplyButton" Content="APPLY SELECTED" Click="Apply_Click" Style="{StaticResource VioletButton}" IsEnabled="False" Margin="0,0,0,15"/><Border Background="#0A0D14" CornerRadius="9" Padding="12"><TextBlock x:Name="PlanHash" Text="No immutable plan yet" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11"/></Border></StackPanel></Border></Grid>
        </StackPanel></ScrollViewer></TabItem>
        <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="30,26,30,38"><DockPanel Margin="0,0,0,18"><TextBlock Text="Detected hardware &amp; software" FontSize="24" FontWeight="Bold"/><Button DockPanel.Dock="Right" Content="SCAN AGAIN" Click="Scan_Click" Style="{StaticResource PrimaryButton}"/></DockPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><Border Style="{StaticResource CardStyle}" Margin="0,0,0,14"><StackPanel><TextBlock Text="HARDWARE &amp; WINDOWS" FontWeight="SemiBold"/><ListView x:Name="HardwareDetails" Margin="0,12,0,0" MaxHeight="290"><ListView.ItemTemplate><DataTemplate><Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" Foreground="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></StackPanel></Border><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="INSTALLED GAMES (STEAM)" FontWeight="SemiBold"/><ListBox x:Name="GamesList" Margin="0,10,0,0" MaxHeight="190"/></StackPanel></Border></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><Border Style="{StaticResource CardStyle}" Margin="0,0,0,14"><StackPanel><TextBlock Text="NETWORK ADAPTERS" FontWeight="SemiBold"/><ListView x:Name="NetworkList" Margin="0,10,0,0" MaxHeight="235"><ListView.ItemTemplate><DataTemplate><StackPanel Margin="0,6"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView></StackPanel></Border><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="STARTUP REGISTRATIONS" FontWeight="SemiBold"/><DataGrid x:Name="StartupGrid" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="240" Margin="0,10,0,0"><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="110"/><DataGridTextColumn Header="Executable" Binding="{Binding Command}" Width="130"/></DataGrid.Columns></DataGrid></StackPanel></Border></StackPanel></Grid></StackPanel></ScrollViewer></TabItem>
        <TabItem><Grid Margin="30,26,30,30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="RecommendationSearch" TextChanged="RecommendationSearch_TextChanged" ToolTip="Search recommendations"/><ComboBox x:Name="RecommendationFilter" Grid.Column="1" Margin="10,0" SelectionChanged="RecommendationFilter_SelectionChanged"><ComboBoxItem Content="All recommendations" IsSelected="True"/><ComboBoxItem Content="Selected"/><ComboBoxItem Content="Available"/><ComboBoxItem Content="Already optimized"/></ComboBox><Button Grid.Column="2" Content="APPLY SELECTED" Click="Apply_Click" Style="{StaticResource VioletButton}"/></Grid><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource CardStyle}" Margin="0,0,14,0"><DockPanel><Grid DockPanel.Dock="Top" Margin="4,0,4,10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="SelectAllCheck" Content="Select all" IsThreeState="True" Click="SelectAll_Click" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="Select all available recommendations"/><TextBlock x:Name="SelectionCountText" Grid.Column="1" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="16,0" TextTrimming="CharacterEllipsis"/><Button x:Name="ClearSelectionButton" Grid.Column="2" Content="Clear selection" Click="ClearSelection_Click" Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="0"/></Grid><Border DockPanel.Dock="Top" Height="1" Background="#222737" Margin="0,0,0,8"/><ListBox x:Name="RecommendationsList" SelectionChanged="RecommendationsList_SelectionChanged"><ListBox.ItemTemplate