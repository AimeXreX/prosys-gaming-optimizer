        <TabItem><Grid Margin="30,26,30,30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="150"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,18"><TextBlock Text="Live diagnostics snapshot" FontSize="24" FontWeight="Bold"/><Button DockPanel.Dock="Right" Content="REFRESH" Click="RefreshDiagnostics_Click" Style="{StaticResource SecondaryButton}"/></DockPanel><UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,14"><Border Style="{StaticResource CardStyle}" Margin="0,0,10,0"><StackPanel><TextBlock Text="AVAILABLE MEMORY" Foreground="{StaticResource Muted}"/><TextBlock x:Name="AvailableMemoryText" Text="—" FontSize="25" FontWeight="Bold" Margin="0,10,0,0"/></StackPanel></Border><Border Style="{StaticResource CardStyle}" Margin="0,0,10,0"><StackPanel><TextBlock Text="RUNNING SERVICES" Foreground="{StaticResource Muted}"/><TextBlock x:Name="RunningServicesText" Text="—" FontSize="25" FontWeight="Bold" Margin="0,10,0,0"/></StackPanel></Border><Border Style="{StaticResource CardStyle}" Margin="0,0,10,0"><StackPanel><TextBlock Text="NETWORK UP" Foreground="{StaticResource Muted}"/><TextBlock x:Name="NetworkUpText" Text="—" FontSize="25" FontWeight="Bold" Margin="0,10,0,0"/></StackPanel></Border><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="ANTI-CHEAT" Foreground="{StaticResource Muted}"/><TextBlock x:Name="AntiCheatText" Text="—" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border></UniformGrid><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource CardStyle}" Margin="0,0,14,0"><StackPanel><TextBlock Text="TOP MEMORY CONSUMERS" FontWeight="SemiBold"/><DataGrid x:Name="ProcessesGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,12,0,0"><DataGrid.Columns><DataGridTextColumn Header="Process" Binding="{Binding Name}" Width="*"/><DataGridText