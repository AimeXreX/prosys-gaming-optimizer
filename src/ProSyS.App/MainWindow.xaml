<Window x:Class="ProSyS.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProSyS Gaming Optimizer" Width="1320" Height="820" MinWidth="1040" MinHeight="680" WindowStartupLocation="CenterScreen"
        Background="#07070A" Foreground="#F5F3FF" FontFamily="./Assets/Fonts/#Vazirmatn" PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <SolidColorBrush x:Key="Card" Color="#141419"/><SolidColorBrush x:Key="Accent" Color="#7C3AED"/><SolidColorBrush x:Key="AccentBlue" Color="#38D9B6"/><SolidColorBrush x:Key="Muted" Color="#A8A5B5"/><SolidColorBrush x:Key="Stroke" Color="#2A2935"/>
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#8B5CF6" Offset="0"/><GradientStop Color="#6334EA" Offset="1"/></LinearGradientBrush>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EDF5FF"/></Style>
    <Style x:Key="PrimaryButton" TargetType="Button"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{StaticResource AccentGradient}"/><Setter Property="Padding" Value="18,11"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FDE047"/><Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Background" Value="#1C1B22"/><Setter Property="Foreground" Value="#656270"/><Setter Property="Cursor" Value="Arrow"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Setter Property="Foreground" Value="#EAF2FF"/><Setter Property="Background" Value="#21314A"/></Style>
    <Style x:Key="NavButton" TargetType="Button"><Setter Property="Foreground" Value="#AAB8CC"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="16,11"/><Setter Property="Margin" Value="0,2"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/></Style>
    <Style x:Key="CardStyle" TargetType="Border"><Setter Property="Background" Value="{StaticResource Card}"/><Setter Property="CornerRadius" Value="14"/><Setter Property="BorderBrush" Value="{StaticResource Stroke}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="20"/></Style>
    <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#F5F3FF"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
    <Style TargetType="ListBoxItem"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#F5F3FF"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#231A3D"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1B1825"/></Trigger></Style.Triggers></Style>
    <Style TargetType="ListView"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#EDF5FF"/></Style>
    <Style TargetType="DataGrid"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#EDF5FF"/><Setter Property="BorderThickness" Value="0"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#23334A"/><Setter Property="RowBackground" Value="Transparent"/><Setter Property="AlternatingRowBackground" Value="#101B2B"/><Setter Property="HeadersVisibility" Value="Column"/></Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#1A1920"/><Setter Property="Foreground" Value="#B8B4C7"/><Setter Property="BorderBrush" Value="#302E39"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="Padding" Value="12,9"/><Setter Property="HorizontalContentAlignment" Value="Right"/></Style>
    <Style TargetType="DataGridCell"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#EEEAF7"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,8"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style>
    <Style TargetType="DataGridRow"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="#24232B"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="Foreground" Value="#EEEAF7"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1B1825"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#241B3D"/></Trigger></Style.Triggers></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#111D2D"/><Setter Property="Foreground" Value="#EDF5FF"/><Setter Property="BorderBrush" Value="{StaticResource Stroke}"/><Setter Property="Padding" Value="12,9"/><Setter Property="CaretBrush" Value="{StaticResource Accent}"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Background" Value="#19181F"/><Setter Property="Foreground" Value="#F4F0FF"/><Setter Property="Padding" Value="11,8"/><Setter Property="BorderBrush" Value="#34313F"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton x:Name="DropDownToggle" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" BorderBrush="#34313F" BorderThickness="1" CornerRadius="7" Padding="11,8"><Grid><ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" VerticalAlignment="Center"/><TextBlock Text="⌄" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="#9F96B8"/></Grid></Border></ControlTemplate></ToggleButton.Template></ToggleButton><Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False"><Border Background="#17161D" BorderBrush="#34313F" BorderThickness="1" CornerRadius="7" Padding="4" MinWidth="{TemplateBinding ActualWidth}"><ScrollViewer><StackPanel IsItemsHost="True"/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#F4F0FF"/><Setter Property="Background" Value="#17161D"/><Setter Property="Padding" Value="12,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#2A2050"/></Trigger></Style.Triggers></Style>
    <Style TargetType="ScrollBar"><Setter Property="Width" Value="10"/><Setter Property="Background" Value="#111116"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="{TemplateBinding Background}"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#5B3AC4" CornerRadius="4" Margin="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
  </Window.Resources>
  <Grid x:Name="RootLayout">
    <Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#111116" BorderBrush="#272631" BorderThickness="0,0,1,0">
      <DockPanel Margin="16,22">
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Margin="10,0,0,28"><TextBlock Text="PROSYS" FontSize="27" FontWeight="Bold" Foreground="{StaticResource Accent}"/><TextBlock Text="GAMING CONTROL CENTER" FontSize="9" Foreground="{StaticResource Muted}"/></StackPanel>
          <Button x:Name="DashboardNav" Style="{StaticResource NavButton}" Tag="0" Click="Navigate_Click" Content="▰   DASHBOARD" Foreground="{StaticResource Accent}" Background="#14283A"/>
          <Button x:Name="ScanNav" Style="{StaticResource NavButton}" Tag="1" Click="Navigate_Click" Content="◉   SYSTEM SCAN"/>
          <Button x:Name="RecommendationsNav" Style="{StaticResource NavButton}" Tag="2" Click="Navigate_Click" Content="✦   RECOMMENDATIONS"/>
          <Button x:Name="DiagnosticsNav" Style="{StaticResource NavButton}" Tag="3" Click="Navigate_Click" Content="⌁   DIAGNOSTICS"/>
          <Button x:Name="BackupsNav" Style="{StaticResource NavButton}" Tag="4" Click="Navigate_Click" Content="↶   HISTORY &amp; BACKUPS"/>
          <Button x:Name="BenchmarkNav" Style="{StaticResource NavButton}" Tag="6" Click="Navigate_Click" Content="◫   BENCHMARK &amp; A/B"/>
          <Button x:Name="GameProfilesNav" Style="{StaticResource NavButton}" Tag="7" Click="Navigate_Click" Content="🎮   GAME PROFILES"/>
          <Button x:Name="OverlayNav" Style="{StaticResource NavButton}" Tag="8" Click="Navigate_Click" Content="▣   OVERLAY"/>
          <Button x:Name="SettingsNav" Style="{StaticResource NavButton}" Tag="5" Click="Navigate_Click" Content="⚙   SETTINGS"/>
          <Border Height="1" Background="#1D2B40" Margin="8,22"/>
          <TextBlock Text="PROTECTION" Foreground="#5C6D84" FontSize="10" Margin="14,0,0,10"/>
          <TextBlock Text="  ✓  Backup before changes" FontSize="11" Foreground="#94A6BC" Margin="5"/><TextBlock Text="  ✓  Verify after apply" FontSize="11" Foreground="#94A6BC" Margin="5"/><TextBlock Text="  ✓  Telemetry disabled" FontSize="11" Foreground="#94A6BC" Margin="5"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Margin="10,0"><Border Background="#11291F" CornerRadius="10" Padding="11"><StackPanel><TextBlock Text="● LOCAL MODE" Foreground="{StaticResource Accent}" FontWeight="SemiBold" FontSize="11"/><TextBlock Text="No cloud • No account" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,0"/></StackPanel></Border></StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Grid.Row="0" BorderBrush="#1D2B40" BorderThickness="0,0,0,1" Padding="28,0"><DockPanel LastChildFill="False"><StackPanel DockPanel.Dock="Left" VerticalAlignment="Center"><TextBlock x:Name="PageTitle" Text="Dashboard" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="PageCaption" Text="Live system readiness and safe optimization" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="LanguageButton" Content="فا" Click="Language_Click" Style="{StaticResource SecondaryButton}" Padding="13,8" ToolTip="Switch language and direction"/><Border Background="#122239" CornerRadius="18" Padding="13,8"><TextBlock x:Name="HeaderState" Text="NOT SCANNED" Foreground="{StaticResource AccentBlue}" FontSize="11" FontWeight="SemiBold"/></Border></StackPanel></DockPanel></Border>
      <TabControl x:Name="MainTabs" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectedIndex="0">
        <TabControl.Resources><Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed"/></Style></TabControl.Resources>
        <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="30,26,30,38">
          <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="StatusTitle" Text="READY WHEN YOU ARE" FontSize="34" FontWeight="Bold"/><TextBlock x:Name="StatusSubtitle" Text="Run a scan to build a hardware-aware optimization plan." Foreground="{StaticResource Muted}" FontSize="14" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="ScanButton" Content="SCAN THIS PC" Click="Scan_Click" Style="{StaticResource PrimaryButton}"/><Button Content="EXPORT REPORT" Click="Export_Click" Style="{StaticResource SecondaryButton}"/></StackPanel></Grid>
          <UniformGrid Columns="5" Margin="0,0,0,20">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0"><StackPanel><TextBlock Text="READINESS" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="ReadyScore" Text="—" FontSize="27" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,8,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0"><StackPanel><TextBlock Text="WINDOWS" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="WindowsValue" Text="—" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></Border>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0"><StackPanel><TextBlock Text="CPU" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="CpuValue" Text="—" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0"><StackPanel><TextBlock Text="MEMORY" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="MemoryValue" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="OPTIMIZATIONS" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="AvailableValue" Text="—" FontSize="27" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" Margin="0,8,0,0"/></StackPanel></Border>
          </UniformGrid>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource CardStyle}" Margin="0,0,14,0"><StackPanel><DockPanel><TextBlock Text="SYSTEM OVERVIEW" FontWeight="SemiBold"/><TextBlock x:Name="LastScanText" Text="Never scanned" DockPanel.Dock="Right" Foreground="{StaticResource Muted}"/></DockPanel><ListView x:Name="OverviewList" Margin="0,14,0,0" MaxHeight="275"><ListView.ItemTemplate><DataTemplate><Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" Foreground="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="{Binding Value}" TextTrimming="CharacterEllipsis"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="QUICK OPTIMIZE" FontWeight="SemiBold"/><TextBlock Text="Only selected, compatible and reversible changes are applied." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,8,0,18"/><Button x:Name="QuickPlanButton" Content="REVIEW PLAN" Click="ReviewPlan_Click" Style="{StaticResource SecondaryButton}" IsEnabled="False" Margin="0,0,0,10"/><Button x:Name="ApplyButton" Content="APPLY SELECTED" Click="Apply_Click" Style="{StaticResource PrimaryButton}" IsEnabled="False" Margin="0,0,0,15"/><Border Background="#0D1725" CornerRadius="9" Padding="12"><TextBlock x:Name="PlanHash" Text="No immutable plan yet" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11"/></Border></StackPanel></Border></Grid>
        </StackPanel></ScrollViewer></TabItem>
        <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="30,26,30,38"><DockPanel Margin="0,0,0,18"><TextBlock Text="Detected hardware &amp; software" FontSize="24" FontWeight="Bold"/><Button DockPanel.Dock="Right" Content="SCAN AGAIN" Click="Scan_Click" Style="{StaticResource PrimaryButton}"/></DockPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><Border Style="{StaticResource CardStyle}" Margin="0,0,0,14"><StackPanel><TextBlock Text="HARDWARE &amp; WINDOWS" FontWeight="SemiBold"/><ListView x:Name="HardwareDetails" Margin="0,12,0,0" MaxHeight="290"><ListView.ItemTemplate><DataTemplate><Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" Foreground="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></StackPanel></Border><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="INSTALLED GAMES (STEAM)" FontWeight="SemiBold"/><ListBox x:Name="GamesList" Margin="0,10,0,0" MaxHeight="190"/></StackPanel></Border></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><Border Style="{StaticResource CardStyle}" Margin="0,0,0,14"><StackPanel><TextBlock Text="NETWORK ADAPTERS" FontWeight="SemiBold"/><ListView x:Name="NetworkList" Margin="0,10,0,0" MaxHeight="235"><ListView.ItemTemplate><DataTemplate><StackPanel Margin="0,6"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView></StackPanel></Border><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="STARTUP REGISTRATIONS" FontWeight="SemiBold"/><DataGrid x:Name="StartupGrid" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="240" Margin="0,10,0,0"><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="110"/><DataGridTextColumn Header="Executable" Binding="{Binding Command}" Width="130"/></DataGrid.Columns></DataGrid></StackPanel></Border></StackPanel></Grid></StackPanel></ScrollViewer></TabItem>
        <TabItem><Grid Margin="30,26,30,30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="RecommendationSearch" TextChanged="RecommendationSearch_TextChanged" ToolTip="Search recommendations"/><ComboBox x:Name="RecommendationFilter" Grid.Column="1" Margin="10,0" SelectionChanged="RecommendationFilter_SelectionChanged"><ComboBoxItem Content="All recommendations" IsSelected="True"/><ComboBoxItem Content="Selected"/><ComboBoxItem Content="Available"/><ComboBoxItem Content="Already optimized"/></ComboBox><Button Grid.Column="2" Content="APPLY SELECTED" Click="Apply_Click" Style="{StaticResource PrimaryButton}"/></Grid><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource CardStyle}" Margin="0,0,14,0"><ListBox x:Name="RecommendationsList" SelectionChanged="RecommendationsList_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#24364F" BorderThickness="0,0,0,1" Padding="4,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Center" Margin="0,0,12,0"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel><Border Grid.Column="2" Background="#102A28" CornerRadius="8" Padding="9,5" VerticalAlignment="Center" Margin="12,0,0,0"><TextBlock Text="{Binding Risk}" Foreground="{StaticResource Accent}" FontSize="10"/></Border></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Border><Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="OPTIMIZATION DETAILS" FontWeight="SemiBold"/><TextBlock x:Name="DetailName" Text="Select a recommendation" FontSize="20" FontWeight="SemiBold" Margin="0,20,0,8"/><TextBlock x:Name="DetailDescription" Text="Technical and safety details will appear here." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/><Border Height="1" Background="#26364E" Margin="0,20"/><TextBlock x:Name="DetailWhy" TextWrapping="Wrap"/><TextBlock x:Name="DetailEvidence" Foreground="{StaticResource AccentBlue}" Margin="0,14,0,0" TextWrapping="Wrap"/><TextBlock x:Name="DetailRestore" Foreground="{StaticResource Muted}" Margin="0,14,0,0" TextWrapping="Wrap"/><TextBlock x:Name="DetailCurrent" Foreground="{StaticResource Accent}" Margin="0,14,0,0" TextWrapping="Wrap"/></StackPanel></Border></Grid></Grid></TabItem>
        <TabItem><Grid Margin="30,26,30,30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="150"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,18"><TextBlock Text="Live diagnostics snapshot" FontSize="24" FontWeight="Bold"/><Button DockPanel.Dock="Right" Content="REFRESH" Click="RefreshDiagnostics_Click" Style="{StaticResource SecondaryButton}"/></DockPanel><UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,14"><Border Style="{StaticResource CardStyle}" Margin="0,0,10,0"><StackPanel><TextBlock Text="AVAILABLE MEMORY" Foreground="{StaticResource Muted}"/><TextBlock x:Name="AvailableMemoryText" Text="—" FontSize="25" FontWeight="Bold" Margin="0,10,0,0"/></StackPanel></Border><Border Style="{StaticResource CardStyle}" Margin="0,0,10,0"><StackPanel><TextBlock Text="RUNNING SERVICES" Foreground="{StaticResource Muted}"/><TextBlock x:Name="RunningServicesText" Text="—" FontSize="25" FontWeight="Bold" Margin="0,10,0,0"/></StackPanel></Border><Border Style="{StaticResource CardStyle}" Margin="0,0,10,0"><StackPanel><TextBlock Text="NETWORK UP" Foreground="{StaticResource Muted}"/><TextBlock x:Name="NetworkUpText" Text="—" FontSize="25" FontWeight="Bold" Margin="0,10,0,0"/></StackPanel></Border><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="ANTI-CHEAT" Foreground="{StaticResource Muted}"/><TextBlock x:Name="AntiCheatText" Text="—" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border></UniformGrid><Border Grid.Row="2" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="TOP MEMORY CONSUMERS" FontWeight="SemiBold"/><DataGrid x:Name="ProcessesGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,12,0,0"><DataGrid.Columns><DataGridTextColumn Header="Process" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="PID" Binding="{Binding Id}" Width="80"/><DataGridTextColumn Header="Memory" Binding="{Binding Memory}" Width="110"/><DataGridTextColumn Header="CPU time" Binding="{Binding CpuTime}" Width="110"/><DataGridTextColumn Header="Class" Binding="{Binding Classification}" Width="170"/></DataGrid.Columns></DataGrid></StackPanel></Border></Grid></TabItem>
        <TabItem><Grid Margin="30,26,30,30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,18"><StackPanel><TextBlock Text="History &amp; recovery" FontSize="24" FontWeight="Bold"/><TextBlock Text="Every change session is journaled locally." Foreground="{StaticResource Muted}"/></StackPanel><Button DockPanel.Dock="Right" Content="REFRESH" Click="RefreshHistory_Click" Style="{StaticResource SecondaryButton}"/></DockPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource CardStyle}" Margin="0,0,14,0"><ListBox x:Name="BackupsList" SelectionChanged="BackupsList_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="0,9"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Border><Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="SELECTED SESSION" FontWeight="SemiBold"/><TextBlock x:Name="BackupDetail" Text="Choose a session to inspect its recovery state." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,18,0,22"/><Button x:Name="RestoreSelectedButton" Content="RESTORE ORIGINAL STATE" Click="RestoreSelected_Click" Style="{StaticResource PrimaryButton}" IsEnabled="False"/></StackPanel></Border></Grid></Grid></TabItem>
        <TabItem><ScrollViewer><StackPanel Margin="30,26" MaxWidth="760" HorizontalAlignment="Left"><TextBlock Text="Settings" FontSize="24" FontWeight="Bold"/><TextBlock Text="Local preferences and transparency controls" Foreground="{StaticResource Muted}" Margin="0,4,0,22"/><Border Style="{StaticResource CardStyle}" Margin="0,0,0,14"><StackPanel><TextBlock Text="LANGUAGE &amp; DIRECTION" FontWeight="SemiBold"/><TextBlock Text="Switch the interface between English/LTR and Persian/RTL." Foreground="{StaticResource Muted}" Margin="0,8,0,14"/><Button Content="SWITCH ENGLISH / فارسی" Click="Language_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"/></StackPanel></Border><Border Style="{StaticResource CardStyle}" Margin="0,0,0,14"><StackPanel><TextBlock Text="LOCAL DATA" FontWeight="SemiBold"/><TextBlock x:Name="DataPathText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="PRIVACY" FontWeight="SemiBold"/><TextBlock Text="Telemetry: OFF&#x0a;Cloud account: NOT REQUIRED&#x0a;Hardware identifiers: NOT EXPORTED&#x0a;Optimization and backup data remain on this PC." Foreground="{StaticResource Muted}" LineHeight="23" Margin="0,8,0,0"/></StackPanel></Border><Border Style="{StaticResource CardStyle}" Margin="0,14,0,0"><StackPanel><TextBlock Text="SYSTEM RECOVERY" FontWeight="SemiBold"/><TextBlock Text="Create a Windows restore point through the short-lived, allowlisted administrator helper." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,14"/><Button Content="CREATE RESTORE POINT" Click="CreateRestorePoint_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"/><TextBlock x:Name="RestorePointStatusText" Foreground="{StaticResource AccentBlue}" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
        <TabItem><ScrollViewer><StackPanel Margin="30,26"><TextBlock Text="PRESENTMON BENCHMARK" FontSize="24" FontWeight="Bold"/><TextBlock Text="Capture real frame times, FPS lows and variance without injecting into the game." Foreground="{StaticResource Muted}" Margin="0,4,0,20"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource CardStyle}" Margin="0,0,14,0"><StackPanel><TextBlock Text="CAPTURE SETTINGS" FontWeight="SemiBold"/><TextBlock Text="Game process name" Foreground="{StaticResource Muted}" Margin="0,14,0,5"/><TextBox x:Name="BenchmarkProcessText" Text="game.exe"/><TextBlock Text="Duration (seconds)" Foreground="{StaticResource Muted}" Margin="0,14,0,5"/><ComboBox x:Name="BenchmarkDuration"><ComboBoxItem Content="15"/><ComboBoxItem Content="30" IsSelected="True"/><ComboBoxItem Content="60"/><ComboBoxItem Content="120"/></ComboBox><TextBlock x:Name="PresentMonTrustText" Text="Checking PresentMon trust…" Foreground="{StaticResource AccentBlue}" TextWrapping="Wrap" Margin="0,18,0,12"/><Button Content="START CAPTURE" Click="StartBenchmark_Click" Style="{StaticResource PrimaryButton}"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="LATEST RESULT" FontWeight="SemiBold"/><TextBlock x:Name="BenchmarkResultText" Text="No benchmark has been captured yet." Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="25" Margin="0,18,0,0"/><Button Content="COMPARE LAST TWO RUNS" Click="CompareBenchmarks_Click" Style="{StaticResource SecondaryButton}" Margin="0,22,0,0"/></StackPanel></Border></Grid><Border Style="{StaticResource CardStyle}" Margin="0,14,0,0"><StackPanel><TextBlock Text="BENCHMARK HISTORY" FontWeight="SemiBold"/><ListBox x:Name="BenchmarkHistoryList" Margin="0,12,0,0" MaxHeight="240"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
        <TabItem><ScrollViewer><StackPanel Margin="30,26"><TextBlock Text="GAME PROFILES" FontSize="24" FontWeight="Bold"/><TextBlock Text="Save per-game optimization choices and restore temporary changes when the game exits." Foreground="{StaticResource Muted}" Margin="0,4,0,20"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource CardStyle}" Margin="0,0,14,0"><StackPanel><TextBlock Text="PROFILE EDITOR" FontWeight="SemiBold"/><TextBlock Text="Profile name" Foreground="{StaticResource Muted}" Margin="0,14,0,5"/><TextBox x:Name="ProfileNameText"/><TextBlock Text="Game process" Foreground="{StaticResource Muted}" Margin="0,12,0,5"/><TextBox x:Name="ProfileProcessText"/><TextBlock Text="Executable path (optional)" Foreground="{StaticResource Muted}" Margin="0,12,0,5"/><TextBox x:Name="ProfilePathText"/><ComboBox x:Name="ProfileKindBox" Margin="0,14,0,0"><ComboBoxItem Content="Safe" IsSelected="True"/><ComboBoxItem Content="Balanced"/><ComboBoxItem Content="Competitive"/></ComboBox><CheckBox x:Name="ProfileRestoreCheck" Content="Restore temporary changes when game exits" IsChecked="True" Margin="0,15,0,0"/><CheckBox x:Name="ProfileOverlayCheck" Content="Show safe external overlay" IsChecked="True" Margin="0,8,0,14"/><StackPanel Orientation="Horizontal"><Button Content="SAVE PROFILE" Click="SaveProfile_Click" Style="{StaticResource PrimaryButton}"/><Button Content="LAUNCH" Click="LaunchProfile_Click" Style="{StaticResource SecondaryButton}"/></StackPanel><TextBlock x:Name="GameSessionStatusText" Foreground="{StaticResource AccentBlue}" TextWrapping="Wrap" Margin="0,14,0,0"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="SAVED PROFILES" FontWeight="SemiBold"/><ListBox x:Name="GameProfilesList" SelectionChanged="GameProfilesList_SelectionChanged" Margin="0,12,0,0" MaxHeight="430" DisplayMemberPath="Name"/></StackPanel></Border></Grid></StackPanel></ScrollViewer></TabItem>
        <TabItem><ScrollViewer><StackPanel Margin="30,26"><TextBlock Text="SAFE PERFORMANCE OVERLAY" FontSize="24" FontWeight="Bold"/><TextBlock Text="A click-through external window; no DLL injection and no game memory access." Foreground="{StaticResource Muted}" Margin="0,4,0,20"/><Border Style="{StaticResource CardStyle}" MaxWidth="760" HorizontalAlignment="Left"><StackPanel><TextBlock Text="OVERLAY STATUS" FontWeight="SemiBold"/><TextBlock x:Name="OverlayStatusText" Text="Stopped" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" Margin="0,15,0,4"/><TextBlock Text="Displays CPU, memory and network throughput using documented Windows counters." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Margin="0,22,0,0"><Button Content="SHOW OVERLAY" Click="ShowOverlay_Click" Style="{StaticResource PrimaryButton}"/><Button Content="HIDE OVERLAY" Click="HideOverlay_Click" Style="{StaticResource SecondaryButton}"/></StackPanel></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
      </TabControl>
    </Grid>
  </Grid>
</Window>
