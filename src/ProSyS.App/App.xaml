<Application x:Class="ProSyS.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Surface" Color="#111827"/>
    <SolidColorBrush x:Key="Card" Color="#182234"/>
    <SolidColorBrush x:Key="Accent" Color="#48E5C2"/>
    <SolidColorBrush x:Key="Muted" Color="#94A3B8"/>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#07111D"/><Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="Padding" Value="18,10"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,10,0"/>
    </Style>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E8EEF8"/></Style>
  </Application.Resources>
</Application>
